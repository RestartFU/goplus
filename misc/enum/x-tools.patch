+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"Result", "Result.Ok", "Result.Err", "Option", "Option.Some", "Option.None"} {
+		obj, _ := pkg2.Scope().Lookup(name).(*types.TypeName)
+		if obj == nil {
