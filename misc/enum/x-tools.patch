+	const src = `package p
+
+type Box[T any] struct { Value T }
+
+func (box Box[T]) Map[U any](convert func(T) U) U {
+	return convert(box.Value)
+}
+`
+	fset := token.NewFileSet()
+	f, err := goparser.ParseFile(fset, "p.go", src, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pkg1, err := new(types.Config).Check("p", fset, []*ast.File{f}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := gcimporter.IExportShallow(fset, pkg1, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pkg2, err := gcimporter.IImportShallow(fset, gcimporter.GetPackagesFromMap(make(map[string]*types.Package)), data, "p", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	box := pkg2.Scope().Lookup("Box").Type().(*types.Named)
+	method, _, _ := types.LookupFieldOrMethod(box, false, pkg2, "Map")
+	if method == nil {
+		t.Fatal("Map method missing after shallow round trip")
+	}
+	sig := method.Type().(*types.Signature)
+	if sig.RecvTypeParams().Len() != 1 || sig.TypeParams().Len() != 1 {
