+	for _, name := range []string{"Result", "Ok", "Err", "Value", "Message"} {
+		found := false
+		ast.Inspect(consumerFile, func(n ast.Node) bool {
+			if id, ok := n.(*ast.Ident); ok && id.Name == name && info.Uses[id] != nil {
+				found = true
+			}
+			return true
+		})
+		if !found {
+			t.Errorf("consumer has no recorded use for %s", name)
+		}
+	}
+}
