+func enumSymbol(m *protocol.Mapper, tf *token.File, decl *ast.EnumDecl) (protocol.DocumentSymbol, error) {
+	s := protocol.DocumentSymbol{
+		Name:   decl.Name.Name,
+		Kind:   protocol.Enum,
+		Detail: "enum",
+	}
+	var err error
+	s.Range, err = m.NodeRange(tf, decl)
+	if err != nil {
+		return protocol.DocumentSymbol{}, err
+	}
+	s.SelectionRange, err = m.NodeRange(tf, decl.Name)
+	if err != nil {
+		return protocol.DocumentSymbol{}, err
+	}
+	for _, variant := range decl.Variants {
+		child := protocol.DocumentSymbol{
+			Name: variant.Name.Name,
+			Kind: protocol.EnumMember,
+		}
+		if variant.Fields != nil {
+			child.Detail = "struct{...}"
+			child.Children = fieldListSymbols(m, tf, variant.Fields, protocol.Field)
+		}
+		if rng, err := m.NodeRange(tf, variant); err == nil {
+			child.Range = rng
+		}
+		if rng, err := m.NodeRange(tf, variant.Name); err == nil {
+			child.SelectionRange = rng
+		}
+		s.Children = append(s.Children, child)
+	}
+	return s, nil
+}
